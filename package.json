{
  "name": "sproto-arena",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local Canvas 2D fighting-game prototype",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs && node scripts/directional-smoke.mjs && node scripts/spit-smoke.mjs && node scripts/throw-smoke.mjs && node scripts/movement-smoke.mjs && node scripts/reaction-smoke.mjs",
    "story-smoke": "node scripts/story-smoke.mjs",
    "qa": "npm run smoke && npm run story-smoke && node scripts/game-qa.mjs && node scripts/fighter-qa.mjs && npm run sprite-scale-qa",
    "partners-qa": "node scripts/pissing-assist-qa.mjs && node scripts/partner-expansion-qa.mjs",
    "versus-smoke": "node scripts/versus-smoke.mjs && node scripts/presentation-smoke.mjs",
    "sprite-scale-qa": "node scripts/sprite-scale-qa.mjs",
    "aerial-kick-art-smoke": "node scripts/aerial-kick-art-smoke.mjs",
    "motion-review-smoke": "node scripts/motion-review-smoke.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
